@page "/"
@layout RecipeLayout
@rendermode InteractiveServer
@inject RecipeService RecipeService

<PageTitle>Recipe Book</PageTitle>


<SearchBar @bind-SearchText="searchText" />


<p class="text-muted mb-3">
    Showing @filteredRecipes.Count of @recipes.Count recipes
</p>

<div class="row">
    @foreach (var recipe in filteredRecipes)
    {
        <div class="col-md-4 mb-4">
            <CardTemplate>
                <Header>@recipe.Title</Header>
                <Body>
                    <img src="@recipe.ImageUrl" class="img-fluid rounded mb-2" alt="@recipe.Title" />
                    <span class="badge bg-secondary mb-2">@recipe.Category</span>
                    <p class="text-muted">@recipe.Description</p>
                </Body>
                <Footer>
                    <a href="/recipes/@recipe.Id" class="card-header bg-dark text-white fw-bold">
                        View Recipe →
                    </a>
                </Footer>
            </CardTemplate>
        </div>
    }

    @if (filteredRecipes.Count == 0)
    {
        <div class="col-12">
            <p class="text-muted text-center">No recipes found for "<strong>@searchText</strong>" 😔</p>
        </div>
    }
</div>

@code {
    private List<Recipe> recipes = new();
    private string searchText = string.Empty;

    private List<Recipe> filteredRecipes => recipes
        .Where(r => string.IsNullOrEmpty(searchText) ||
                    r.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    r.Category.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        recipes = await RecipeService.GetBestRecipesAsync();
    }
}